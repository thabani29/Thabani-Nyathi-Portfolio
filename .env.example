# Personal access token (classic) with read:user scope for accurate private repo counts
GITHUB_TOKEN=

# EmailJS browser configuration. These values are public; restrict allowed origins in EmailJS.
# Never add an EmailJS private key or other secret as a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
